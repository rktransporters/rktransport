APP_NAME=RK Transport API
DEBUG=false
TIMEZONE=Asia/Dubai
CURRENCY_CODE=AED.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/DATABASE?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password12345
ADMIN_EMAIL=admin@example.com
ALLOWED_ORIGINS=http://localhost:3000,https://rk-transport.com,https://www.rk-transport.com
COOKIE_NAME=access_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.rk-transport.com
FRONTEND_URL=https://rk-transport.com
REVALIDATE_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Image storage: local | cloudinary | vercel_blob.
IMAGE_STORAGE_PROVIDER=local
UPLOAD_DIR=/var/www/rktransport/uploads
PUBLIC_FILES_BASE_URL=https://api.rk-transport.com/uploads

# Required only when IMAGE_STORAGE_PROVIDER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_FILE_SIZE=4000000
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PUBLIC_POST=20
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
EMAIL_PROVIDER=smtp
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
